# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
REALTIME_PORT=4001

# Local infrastructure from docker-compose.yml
DATABASE_URL=postgresql://placesync:placesync_dev@localhost:5432/placesync?schema=public
REDIS_URL=redis://localhost:6380

# Comma-separated origins allowed to call the API (web dev server, Tauri)
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost

# Image generation for assets (DESIGN-DIRECTION.md). Fill in locally only.
GEMINI_API_KEY=
