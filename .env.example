# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=4000
REALTIME_PORT=4001

# Local infrastructure from docker-compose.yml
DATABASE_URL=postgresql://cyrus:cyrus_dev@localhost:5432/cyrus?schema=public
REDIS_URL=redis://localhost:6380

# Separate database for automated tests (created and migrated automatically by `pnpm test`; wiped on every run)
TEST_DATABASE_URL=postgresql://cyrus:cyrus_dev@localhost:5432/cyrus_test?schema=public

# Comma-separated origins allowed to call the API (web dev server, Tauri)
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost

# Auth. APP_SECRET signs tokens and hashes one-time codes: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# true when the API is served over HTTPS (production)
COOKIE_SECURE=false

# Email. "console" prints emails in the worker log; "smtp" sends them (see SMTP_* below).
MAIL_MODE=smtp
MAIL_FROM=Cyrus <no-reply@cyrus.local>

# Image generation for assets (DESIGN-DIRECTION.md). Fill in locally only.
GEMINI_API_KEY=

# Web app address, used in email links
WEB_APP_URL=http://localhost:5173

# Email: "smtp" sends through SMTP. In development that is Mailpit (http://localhost:8025 shows the inbox).
# For real sending later, put Brevo's SMTP details here (smtp-relay.brevo.com, port 587, your login and key).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# File storage (S3-compatible). Development: SeaweedFS from docker-compose.yml.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=cyrus-files
S3_ACCESS_KEY=cyrus-dev-key
S3_SECRET_KEY=cyrus-dev-secret
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=10
# Uploaded files are rebuilt (cleaned) before anyone else can open them.
# With the sanitizer container running (docker compose up -d sanitizer) point the worker at it;
# leave empty to clean files in a throw-away process on the worker's machine.
SANITIZER_URL=http://localhost:4010
