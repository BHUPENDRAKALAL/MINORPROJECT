{
  "name": "@placesync/api",
  "version": "0.1.0",
  "private": true,
  "description": "PlaceSync backend: api, realtime, relay and worker processes from one codebase",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main/api.ts",
    "dev:realtime": "tsx watch --env-file-if-exists=../../.env src/main/realtime.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main/worker.ts",
    "dev:relay": "tsx watch --env-file-if-exists=../../.env src/main/relay.ts",
    "build": "tsup",
    "start:api": "node --env-file-if-exists=../../.env dist/api.js",
    "start:realtime": "node --env-file-if-exists=../../.env dist/realtime.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "start:relay": "node --env-file-if-exists=../../.env dist/relay.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "smoke": "tsx --env-file-if-exists=../../.env src/scripts/smoke-pipeline.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@placesync/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.7.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
